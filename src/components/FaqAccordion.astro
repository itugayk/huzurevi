---
import Icon from "./Icon.astro";
import type { Faq, FaqGroup } from "../data/site";

interface Props {
  groups?: FaqGroup[];
  items?: Faq[];
}
const { groups, items } = Astro.props;

const normalized: FaqGroup[] = groups
  ? groups
  : [{ category: "", icon: "", items: items ?? [] }];
---

<div class="space-y-10">
  {
    normalized.map((group) => (
      <div data-reveal>
        {group.category && (
          <h3 class="flex items-center gap-3 text-2xl mb-5">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-brand-100 text-brand-600">
              <Icon name={group.icon} size={24} />
            </span>
            {group.category}
          </h3>
        )}
        <div class="space-y-3">
          {group.items.map((item) => (
            <details class="faq card overflow-hidden">
              <summary class="flex items-center justify-between gap-4 p-5 md:p-6 text-lg font-bold text-brand-800">
                <span>{item.q}</span>
                <span class="faq-icon grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600 transition-transform duration-300">
                  <Icon name="plus" size={22} />
                </span>
              </summary>
              <div class="px-5 md:px-6 pb-6 -mt-1 text-ink-soft leading-relaxed">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))
  }
</div>
