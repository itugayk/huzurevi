---
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  eyebrowIcon?: string;
  title: string;
  intro?: string;
  align?: "center" | "left";
  light?: boolean;
}
const { eyebrow, eyebrowIcon, title, intro, align = "center", light = false } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---

<div class:list={["max-w-2xl", alignClass]} data-reveal>
  {
    eyebrow && (
      <span class:list={["eyebrow", light && "!text-peach-300"]}>
        {eyebrowIcon && <Icon name={eyebrowIcon} size={18} />}
        {eyebrow}
      </span>
    )
  }
  <h2 class:list={["mt-3 text-3xl md:text-[2.6rem]", light && "!text-white"]}>{title}</h2>
  {
    intro && (
      <p class:list={["mt-4 text-lg leading-relaxed", light ? "text-white/80" : "text-ink-soft"]}>
        {intro}
      </p>
    )
  }
</div>
