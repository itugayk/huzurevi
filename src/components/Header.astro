---
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header data-header class="sticky top-0 z-50">
  <!-- Utility bar -->
  <div class="bg-brand-700 text-white text-[0.95rem]">
    <div class="container-x flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
      <a
        href={`tel:${site.emergencyHref}`}
        class="inline-flex items-center gap-2 font-bold hover:text-peach-200 transition-colors"
      >
        <Icon name="phone" size={18} />
        <span class="text-white/80 font-semibold">Acil Hat:</span>
        {site.emergency}
      </a>

      <div class="flex items-center gap-2">
        <span class="hidden sm:inline text-white/70 text-sm mr-1">Erişilebilirlik:</span>
        <button
          type="button"
          data-a11y="font-dec"
          class="grid h-9 w-9 place-items-center rounded-full bg-white/10 hover:bg-white/20 transition-colors text-sm font-extrabold"
          aria-label="Yazıyı küçült"
        >A−</button>
        <button
          type="button"
          data-a11y="font-inc"
          class="grid h-9 w-9 place-items-center rounded-full bg-white/10 hover:bg-white/20 transition-colors text-base font-extrabold"
          aria-label="Yazıyı büyüt"
        >A+</button>
        <button
          type="button"
          data-a11y="contrast"
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 h-9 rounded-full bg-white/10 hover:bg-white/20 transition-colors px-3 text-sm font-bold"
          aria-label="Yüksek kontrast modunu aç/kapat"
        >
          <Icon name="sun" size={17} />
          <span class="hidden md:inline">Kontrast</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main bar -->
  <div data-headbar class="bg-cream-50/95 backdrop-blur-md transition-shadow duration-300 border-b border-brand-100/70">
    <div class="container-x flex items-center justify-between gap-4 py-3">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label={`${site.name} ana sayfa`}>
        <span
          class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 text-white shadow-md group-hover:scale-105 transition-transform"
        >
          <Icon name="hand-heart" size={26} />
        </span>
        <span class="leading-tight">
          <span class="block font-display font-extrabold text-xl text-brand-800">{site.name}</span>
          <span class="block text-[0.78rem] font-semibold tracking-wide text-ink-muted">Huzurevi & Yaşlı Bakım Merkezi</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Ana menü">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "px-3.5 py-2.5 rounded-full text-[1.02rem] font-bold transition-colors",
                isActive(item.href)
                  ? "text-brand-700 bg-brand-100"
                  : "text-ink-soft hover:text-brand-700 hover:bg-brand-50",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a href="/iletisim" class="btn btn-accent hidden sm:inline-flex !min-h-[3rem] !px-5">
          <Icon name="calendar" size={20} />
          Ziyaret Planlayın
        </a>

        <!-- Mobile toggle -->
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="lg:hidden grid h-12 w-12 place-items-center rounded-2xl bg-brand-100 text-brand-700"
          aria-label="Menüyü aç"
        >
          <Icon name="menu" size={26} />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    data-mobile-menu
    hidden
    class="lg:hidden bg-cream-50 border-b border-brand-100 shadow-soft"
  >
    <nav class="container-x py-4 flex flex-col gap-1" aria-label="Mobil menü">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "px-4 py-3.5 rounded-2xl text-lg font-bold transition-colors",
              isActive(item.href)
                ? "text-brand-700 bg-brand-100"
                : "text-ink-soft hover:bg-brand-50",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/iletisim" class="btn btn-accent mt-2 w-full">
        <Icon name="calendar" size={20} />
        Ziyaret Planlayın
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.hasAttribute("hidden");
      if (open) {
        menu.removeAttribute("hidden");
        toggle.setAttribute("aria-expanded", "true");
        toggle.setAttribute("aria-label", "Menüyü kapat");
      } else {
        menu.setAttribute("hidden", "");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Menüyü aç");
      }
    });
    // Close after navigating
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        menu.setAttribute("hidden", "");
        toggle.setAttribute("aria-expanded", "false");
      })
    );
  }

  // Subtle shadow once scrolled
  const bar = document.querySelector<HTMLElement>("[data-headbar]");
  if (bar) {
    const onScroll = () => bar.classList.toggle("header-shadow", window.scrollY > 12);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
