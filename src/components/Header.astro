---
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header data-header class="sticky top-0 z-50">
  <!-- Utility bar -->
  <div class="bg-brand-800 text-white/90 text-sm">
    <div class="container-x flex items-center justify-between gap-4 h-10">
      <a
        href={`tel:${site.emergencyHref}`}
        class="inline-flex items-center gap-2 font-semibold hover:text-peach-200 transition-colors"
      >
        <Icon name="phone" size={16} class="text-peach-300" />
        <span class="text-white/65">Acil Hat 7/24:</span>
        <span class="font-bold text-white">{site.emergency}</span>
      </a>

      <div class="flex items-center gap-1.5">
        <span class="hidden md:inline text-white/55 mr-1">Erişilebilirlik</span>
        <div class="flex items-center rounded-full bg-white/10 p-0.5">
          <button
            type="button"
            data-a11y="font-dec"
            class="grid h-7 w-8 place-items-center rounded-full hover:bg-white/15 transition-colors text-xs font-extrabold"
            aria-label="Yazıyı küçült"
          >A−</button>
          <button
            type="button"
            data-a11y="font-inc"
            class="grid h-7 w-8 place-items-center rounded-full hover:bg-white/15 transition-colors text-sm font-extrabold"
            aria-label="Yazıyı büyüt"
          >A+</button>
        </div>
        <button
          type="button"
          data-a11y="contrast"
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 h-8 rounded-full bg-white/10 hover:bg-white/15 transition-colors px-2.5 font-semibold"
          aria-label="Yüksek kontrast modunu aç/kapat"
        >
          <Icon name="sun" size={16} />
          <span class="hidden sm:inline">Kontrast</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main bar -->
  <div
    data-headbar
    class="bg-cream-50/85 backdrop-blur-md border-b border-brand-100/70"
  >
    <div class="container-x flex items-center gap-3 h-[4.75rem]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group shrink-0 mr-1" aria-label={`${site.name} ana sayfa`}>
        <span
          class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 text-white shadow-sm shadow-brand-500/30 group-hover:scale-105 transition-transform"
        >
          <Icon name="hand-heart" size={24} />
        </span>
        <span class="leading-none">
          <span class="block font-display font-extrabold text-lg xl:text-[1.35rem] text-brand-800 tracking-tight">{site.name}</span>
          <span class="mt-1 hidden 2xl:block text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-ink-muted">Huzurevi & Yaşlı Bakım Merkezi</span>
        </span>
      </a>

      <!-- Desktop nav (xl+) -->
      <nav class="hidden xl:flex items-center gap-0.5 flex-1 justify-center" aria-label="Ana menü">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "group relative px-3 py-2 text-[1.02rem] font-bold whitespace-nowrap transition-colors",
                isActive(item.href) ? "text-brand-800" : "text-ink-soft hover:text-brand-700",
              ]}
            >
              {item.label}
              <span
                class:list={[
                  "pointer-events-none absolute inset-x-2.5 -bottom-0.5 h-[3px] rounded-full bg-peach-400 origin-left transition-transform duration-300 ease-out",
                  isActive(item.href) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100",
                ]}
              />
            </a>
          ))
        }
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2 shrink-0 ml-auto xl:ml-0">
        <a
          href={`tel:${site.phoneHref}`}
          class="hidden sm:inline-flex items-center gap-2 rounded-full h-12 pl-1.5 pr-2 2xl:pr-4 hover:bg-brand-50 transition-colors group"
          aria-label={`Bizi arayın: ${site.phone}`}
        >
          <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-100 text-brand-600 group-hover:bg-brand-200 transition-colors">
            <Icon name="phone" size={18} />
          </span>
          <span class="hidden 2xl:flex flex-col leading-tight">
            <span class="text-[0.7rem] font-semibold text-ink-muted">Hemen arayın</span>
            <span class="font-bold text-brand-800 text-[0.95rem]">{site.phone}</span>
          </span>
        </a>

        <a href="/iletisim" class="btn btn-accent hidden lg:inline-flex !min-h-[3rem] !px-5">
          <Icon name="calendar" size={20} />
          Ziyaret Planlayın
        </a>

        <!-- Mobile / tablet toggle -->
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="xl:hidden grid h-12 w-12 place-items-center rounded-2xl bg-brand-100 text-brand-700 hover:bg-brand-200 transition-colors"
          aria-label="Menüyü aç"
        >
          <span data-menu-icon><Icon name="menu" size={26} /></span>
          <span data-close-icon hidden><Icon name="x" size={26} /></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile / tablet menu (below xl) -->
  <div
    id="mobile-menu"
    data-mobile-menu
    hidden
    class="xl:hidden bg-cream-50 border-b border-brand-100 shadow-soft"
  >
    <nav class="container-x py-4 grid sm:grid-cols-2 gap-1.5" aria-label="Mobil menü">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "flex items-center justify-between px-4 py-3.5 rounded-2xl text-lg font-bold transition-colors",
              isActive(item.href)
                ? "text-brand-800 bg-brand-100"
                : "text-ink-soft hover:bg-brand-50",
            ]}
          >
            {item.label}
            {isActive(item.href) && <Icon name="check" size={20} class="text-peach-600" />}
          </a>
        ))
      }
    </nav>
    <div class="container-x pb-5 flex flex-col sm:flex-row gap-2.5">
      <a href="/iletisim" class="btn btn-accent flex-1">
        <Icon name="calendar" size={20} />
        Ziyaret Planlayın
      </a>
      <a href={`tel:${site.phoneHref}`} class="btn btn-ghost flex-1">
        <Icon name="phone" size={20} />
        {site.phone}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const menuIcon = document.querySelector<HTMLElement>("[data-menu-icon]");
  const closeIcon = document.querySelector<HTMLElement>("[data-close-icon]");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      if (open) menu.removeAttribute("hidden");
      else menu.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Menüyü kapat" : "Menüyü aç");
      menuIcon?.toggleAttribute("hidden", open);
      closeIcon?.toggleAttribute("hidden", !open);
    };

    toggle.addEventListener("click", () => setOpen(menu.hasAttribute("hidden")));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    // Reset when crossing back to desktop width
    window.matchMedia("(min-width: 1280px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Solid background + shadow once scrolled
  const bar = document.querySelector<HTMLElement>("[data-headbar]");
  if (bar) {
    const onScroll = () => bar.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
