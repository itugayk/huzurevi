---
import type { TeamMember } from "../data/site";

interface Props {
  member: TeamMember;
  showBio?: boolean;
}
const { member, showBio = true } = Astro.props;
---

<article class="card group overflow-hidden h-full" data-reveal-item>
  <div class="relative aspect-[4/5] overflow-hidden bg-brand-100">
    <img
      src={member.image}
      alt={`${member.name} — ${member.role}`}
      width="600"
      height="750"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-brand-900/55 to-transparent"></div>
  </div>
  <div class="p-6">
    <h3 class="text-lg text-brand-800">{member.name}</h3>
    <p class="mt-1 font-bold text-peach-600">{member.role}</p>
    {showBio && <p class="mt-3 text-ink-soft leading-relaxed">{member.bio}</p>}
  </div>
</article>
