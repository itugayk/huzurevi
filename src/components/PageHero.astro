---
import Icon from "./Icon.astro";

interface Props {
  eyebrow: string;
  eyebrowIcon?: string;
  title: string;
  intro?: string;
  current: string;
}
const { eyebrow, eyebrowIcon, title, intro, current } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-50/70 border-b border-brand-100">
  <div class="blob" style="width:420px;height:420px;background:#9fc2dd;top:-180px;right:-120px;"></div>
  <div class="blob" style="width:280px;height:280px;background:#efc8ad;bottom:-140px;left:-80px;opacity:.35"></div>

  <div class="container-x relative pt-10 pb-12 md:pt-14 md:pb-16">
    <nav aria-label="Konum" class="mb-5 text-sm font-semibold text-ink-muted">
      <a href="/" class="hover:text-brand-600 transition-colors">Ana Sayfa</a>
      <span class="mx-2 text-brand-300">/</span>
      <span class="text-brand-700">{current}</span>
    </nav>

    <span class="eyebrow" data-reveal>
      {eyebrowIcon && <Icon name={eyebrowIcon} size={18} />}
      {eyebrow}
    </span>
    <h1 class="mt-3 text-4xl md:text-5xl max-w-3xl" data-reveal data-delay="0.05">{title}</h1>
    {
      intro && (
        <p class="mt-4 text-xl text-ink-soft leading-relaxed max-w-2xl" data-reveal data-delay="0.1">
          {intro}
        </p>
      )
    }
  </div>
</section>
