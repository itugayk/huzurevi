---
import { trustBadges } from "../data/site";
import Icon from "./Icon.astro";
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-reveal-group>
  {
    trustBadges.map((b) => (
      <div
        class="card flex items-center gap-4 p-5 min-w-0"
        data-reveal-item
      >
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-600">
          <Icon name={b.icon} size={26} />
        </span>
        <div class="min-w-0">
          <p class="font-display font-extrabold text-brand-800 leading-tight">{b.label}</p>
          <p class="text-sm text-ink-muted break-words">{b.sub}</p>
        </div>
      </div>
    ))
  }
</div>
