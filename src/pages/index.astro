---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustBar from "../components/TrustBar.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Gallery from "../components/Gallery.astro";
import TeamCard from "../components/TeamCard.astro";
import Testimonials from "../components/Testimonials.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBand from "../components/CtaBand.astro";
import { services, gallery, team, values, stats, faqGroups, site } from "../data/site";

const homeFaq = faqGroups.flatMap((g) => g.items).slice(0, 4);
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div class="blob" style="width:460px;height:460px;background:#9fc2dd;top:-160px;right:-120px;" data-parallax="-22"></div>
    <div class="blob" style="width:360px;height:360px;background:#efc8ad;bottom:-140px;left:-120px;opacity:.4" data-parallax="14"></div>

    <div class="container-x relative grid lg:grid-cols-2 gap-10 lg:gap-14 items-center pt-10 pb-14 md:pt-16 md:pb-20">
      <div>
        <span class="chip" data-reveal>
          <Icon name="badge" size={18} class="text-brand-500" />
          T.C. Bakanlık Ruhsatlı Özel Huzurevi
        </span>

        <h1 class="mt-5 text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.08]" data-reveal data-delay="0.05">
          Sevdikleriniz için
          <span class="text-brand-500">sıcak bir yuva</span>,
          güvenilir bir bakım.
        </h1>

        <p class="mt-5 text-xl text-ink-soft leading-relaxed max-w-xl" data-reveal data-delay="0.12">
          Şefkat Yaşam Evi'nde aile büyüklerimiz; 7/24 hekim ve hemşire desteği,
          sıcak bir ortam ve onurlu bir yaşamla huzur buluyor.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3" data-reveal data-delay="0.18">
          <a href="/iletisim" class="btn btn-accent text-lg">
            <Icon name="calendar" size={22} />
            Ziyaret Planlayın
          </a>
          <a href="/tesisimiz" class="btn btn-ghost text-lg">
            <Icon name="home" size={22} />
            Tesisimizi Gezin
          </a>
        </div>

        <div class="mt-8 flex items-center gap-4 text-ink-soft" data-reveal data-delay="0.24">
          <div class="flex items-center gap-1 text-peach-500">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={20} />)}
          </div>
          <p class="font-semibold"><span class="text-brand-800 font-extrabold">%98 aile memnuniyeti</span> · 10+ yıllık güven</p>
        </div>
      </div>

      <div class="relative" data-reveal data-delay="0.1">
        <div class="relative rounded-[2.5rem] overflow-hidden shadow-soft ring-1 ring-brand-100">
          <img
            src="/images/hero.jpg"
            alt="Şefkat Yaşam Evi'nde bir sakinimiz ve güler yüzlü bakım personelimiz bahçede"
            width="1920"
            height="1280"
            fetchpriority="high"
            class="w-full h-full object-cover aspect-[4/3.2]"
          />
        </div>

        <!-- Floating cards -->
        <div class="hidden sm:flex items-center gap-3 card absolute -left-4 top-8 px-4 py-3.5 shadow-soft">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-sage-100 text-sage-600">
            <Icon name="clock" size={24} />
          </span>
          <div>
            <p class="font-display font-extrabold text-brand-800 leading-tight">7/24 Bakım</p>
            <p class="text-sm text-ink-muted">Nöbetçi hemşire</p>
          </div>
        </div>

        <div class="hidden sm:flex items-center gap-3 card absolute -right-4 bottom-8 px-4 py-3.5 shadow-soft">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-100 text-brand-600">
            <Icon name="heart-pulse" size={24} />
          </span>
          <div>
            <p class="font-display font-extrabold text-brand-800 leading-tight">Hekim Gözetimi</p>
            <p class="text-sm text-ink-muted">Düzenli sağlık takibi</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="container-x relative pb-14 md:pb-20">
      <div class="card grid grid-cols-2 lg:grid-cols-4 divide-x divide-y lg:divide-y-0 divide-brand-100" data-reveal>
        {
          stats.map((s) => (
            <div class="p-6 md:p-8 text-center min-w-0">
              <p class="font-display font-extrabold text-3xl md:text-4xl text-brand-600">{s.value}</p>
              <p class="mt-1 text-ink-soft font-semibold text-balance">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ TRUST / SERVICES ============ -->
  <section class="section bg-white">
    <div class="container-x">
      <TrustBar />

      <div class="mt-16">
        <SectionHeading
          eyebrow="Hizmetlerimiz"
          eyebrowIcon="hand-heart"
          title="Kapsamlı bakım, tek bir çatı altında"
          intro="Sağlıktan sosyal yaşama, beslenmeden rehabilitasyona kadar her ihtiyaç profesyonel ekibimizle karşılanır."
        />

        <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
          {services.slice(0, 6).map((service) => <ServiceCard service={service} />)}
        </div>

        <div class="mt-10 text-center" data-reveal>
          <a href="/hizmetlerimiz" class="btn btn-ghost text-lg">
            Tüm hizmetleri inceleyin
            <Icon name="arrow-right" size={20} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FACILITY TOUR ============ -->
  <section class="section">
    <div class="container-x">
      <SectionHeading
        eyebrow="Tesisimiz"
        eyebrowIcon="home"
        title="Hastane değil, gerçek bir ev sıcaklığı"
        intro="Ferah odalar, yeşil bahçe, aydınlık sosyal alanlar ve güvenli yaşam ortamı. Gezmek için fotoğrafa tıklayın."
      />
      <div class="mt-12">
        <Gallery items={gallery.slice(0, 7)} />
      </div>
      <div class="mt-10 text-center" data-reveal>
        <a href="/tesisimiz" class="btn btn-ghost text-lg">
          Tüm galeriyi & oda tiplerini görün
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CARE PHILOSOPHY ============ -->
  <section class="section bg-brand-50/60">
    <div class="container-x grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="relative" data-reveal>
        <div class="rounded-[2.5rem] overflow-hidden shadow-card ring-1 ring-brand-100">
          <img
            src="/images/anlayis-eller.jpg"
            alt="Bir sakinimizin elini şefkatle tutan bakım personeli"
            width="1400"
            height="1000"
            loading="lazy"
            class="w-full object-cover aspect-[4/3]"
          />
        </div>
        <div class="hidden md:block card absolute -bottom-6 -right-4 p-5 max-w-[15rem] shadow-soft">
          <p class="font-display font-extrabold text-brand-700 text-lg">“Bir aile büyüğü gibi”</p>
          <p class="text-sm text-ink-soft mt-1">Her sakinimize kendi büyüğümüzmüş gibi yaklaşırız.</p>
        </div>
      </div>

      <div>
        <SectionHeading
          align="left"
          eyebrow="Bakım Anlayışımız"
          eyebrowIcon="hand-heart"
          title="Güven, şeffaflık ve sevgi üzerine kurulu"
          intro="Sevdiklerinizi emanet ederken içiniz rahat olsun diye, her detayı şeffaflık ve özenle yönetiyoruz."
        />
        <div class="mt-8 grid sm:grid-cols-2 gap-5" data-reveal-group>
          {
            values.slice(0, 4).map((v) => (
              <div class="flex items-start gap-4" data-reveal-item>
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white text-brand-600 shadow-sm">
                  <Icon name={v.icon} size={26} />
                </span>
                <div>
                  <h3 class="text-lg text-brand-800">{v.title}</h3>
                  <p class="mt-1 text-ink-soft leading-relaxed">{v.text}</p>
                </div>
              </div>
            ))
          }
        </div>
        <div class="mt-8" data-reveal>
          <a href="/bakim-anlayisimiz" class="link-underline text-lg">Anlayışımızı keşfedin</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeading
        eyebrow="Sağlık & Bakım Ekibimiz"
        eyebrowIcon="users"
        title="Uzman, güler yüzlü ve özverili bir ekip"
        intro="Hekimlerimiz, hemşirelerimiz ve bakım personelimiz sevdiklerinizin sağlığı ve mutluluğu için yan yana çalışır."
      />
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6" data-reveal-group>
        {team.slice(0, 4).map((member) => <TeamCard member={member} showBio={false} />)}
      </div>
      <div class="mt-10 text-center" data-reveal>
        <a href="/ekip" class="btn btn-ghost text-lg">
          Tüm ekibimizle tanışın
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS + FAQ ============ -->
  <section class="section bg-cream-100">
    <div class="container-x">
      <SectionHeading
        eyebrow="Aile Yorumları"
        eyebrowIcon="heart-pulse"
        title="Ailelerin bize duyduğu güven"
        intro="Sevdiklerini bize emanet eden ailelerin deneyimleri."
      />
      <div class="mt-12">
        <Testimonials />
      </div>

      <div class="mt-20 grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-14 items-start">
        <SectionHeading
          align="left"
          eyebrow="Sıkça Sorulan Sorular"
          eyebrowIcon="clipboard"
          title="Aklınızdaki sorular için"
          intro="Ücretlendirme, ziyaret ve sağlık süreçlerine dair en çok merak edilenler."
        />
        <div>
          <FaqAccordion items={homeFaq} />
          <div class="mt-6" data-reveal>
            <a href="/sss" class="link-underline text-lg">Tüm soruları görüntüleyin</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
