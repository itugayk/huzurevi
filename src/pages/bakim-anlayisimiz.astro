---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import { values } from "../data/site";

const pillars = [
  {
    eyebrow: "Güvenlik",
    icon: "shield-check",
    title: "Her an, her köşede güvende",
    text: "Güvenlik bizim için bir özellik değil, bir önkoşuldur. Yaşam alanlarımız düşmeyi, kaybolmayı ve kazaları önleyecek şekilde tasarlanır.",
    image: "/images/bahce-2.jpg",
    points: ["7/24 kameralı izleme ve gece nöbeti", "Tüm odalarda çağrı butonu", "Kaymaz zemin, tutamaç ve engelsiz erişim", "Yangın algılama ve tahliye sistemi"],
  },
  {
    eyebrow: "Hijyen & Sağlık",
    icon: "sparkles",
    title: "Titiz hijyen, sağlıklı yaşam",
    text: "Enfeksiyonların önlenmesi için günlük rutinlerimiz titizlikle uygulanır; temizlik ve sağlık iç içe yürür.",
    image: "/images/fizyoterapi.jpg",
    points: ["Günlük dezenfeksiyon protokolleri", "Çamaşır ve mutfak hijyeni standartları", "Enfeksiyon kontrol takibi", "Düzenli sağlık ve aşı takvimi"],
  },
  {
    eyebrow: "Aile Şeffaflığı",
    icon: "eye",
    title: "Hiçbir şeyi merak etmeyin",
    text: "Sevdiğinizin her günü hakkında açık ve dürüst bilgilendirme yaparız. Kapımız ve iletişim hattımız her zaman açıktır.",
    image: "/images/yemek.jpg",
    points: ["Düzenli durum bilgilendirmesi", "Açık ziyaret politikası", "Görüntülü görüşme imkânı", "Her değişiklikte anında haber"],
  },
];

const promises = [
  "Her sakinimize bir aile büyüğü gibi davranırız.",
  "Mahremiyet ve onuru her zaman korur, asla taviz vermeyiz.",
  "Sürpriz maliyet çıkarmaz, her şeyi şeffaf paylaşırız.",
  "Kötü bir gün olduğunda da, iyi bir gün olduğunda da sizi ararız.",
];
---

<BaseLayout
  title="Bakım Anlayışımız"
  description="Güven, şeffaflık, güvenlik, hijyen ve sevgi üzerine kurulu bakım anlayışımız — Şefkat Yaşam Evi."
>
  <PageHero
    current="Bakım Anlayışımız"
    eyebrow="Bakım Anlayışımız"
    eyebrowIcon="hand-heart"
    title="Bakım bir hizmet değil, bir sorumluluktur"
    intro="Sevdiklerinizi emanet ederken içinizin rahat olması için; her kararımızı güven, saygı ve şeffaflık üzerine kuruyoruz."
  />

  <!-- Values -->
  <section class="section">
    <div class="container-x">
      <SectionHeading
        eyebrow="Değerlerimiz"
        eyebrowIcon="heart-pulse"
        title="Bizi biz yapan ilkeler"
      />
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-group>
        {
          values.map((v) => (
            <div class="card p-7 h-full" data-reveal-item>
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-50 text-brand-600">
                <Icon name={v.icon} size={30} />
              </span>
              <h3 class="mt-5 text-xl text-brand-800">{v.title}</h3>
              <p class="mt-2.5 text-ink-soft leading-relaxed">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pillars (alternating) -->
  <section class="section bg-white">
    <div class="container-x space-y-16 md:space-y-24">
      {
        pillars.map((p, i) => (
          <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <div class:list={[i % 2 === 1 && "lg:order-2"]} data-reveal>
              <div class="rounded-[2.5rem] overflow-hidden shadow-card ring-1 ring-brand-100">
                <img src={p.image} alt={p.title} width="1400" height="1000" loading="lazy" class="w-full object-cover aspect-[4/3]" />
              </div>
            </div>
            <div class:list={[i % 2 === 1 && "lg:order-1"]}>
              <span class="eyebrow" data-reveal>
                <Icon name={p.icon} size={18} />
                {p.eyebrow}
              </span>
              <h2 class="mt-3 text-3xl md:text-4xl" data-reveal>{p.title}</h2>
              <p class="mt-4 text-lg text-ink-soft leading-relaxed" data-reveal>{p.text}</p>
              <ul class="mt-6 grid sm:grid-cols-2 gap-3" data-reveal-group>
                {p.points.map((pt) => (
                  <li class="flex items-start gap-2.5" data-reveal-item>
                    <Icon name="check-circle" size={22} class="mt-0.5 shrink-0 text-sage-500" />
                    <span class="text-ink-soft">{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Quote band -->
  <section class="section">
    <div class="container-x">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 items-center bg-brand-50/70 rounded-[2.5rem] p-8 md:p-12" data-reveal>
        <div class="rounded-[2rem] overflow-hidden shadow-card max-w-sm">
          <img src="/images/portre-yasli.jpg" alt="Gülümseyen bir büyüğümüz" width="1000" height="1200" loading="lazy" class="w-full object-cover aspect-[5/6]" />
        </div>
        <blockquote class="relative">
          <span class="font-display text-7xl text-peach-300 leading-none">“</span>
          <p class="-mt-6 text-2xl md:text-[1.7rem] font-display font-extrabold text-brand-800 leading-snug">
            İyi bir bakım, sadece sağlığı korumakla kalmaz; bir insanın gülümsemesini, onurunu ve hikâyesini de korur.
          </p>
          <footer class="mt-5 text-ink-soft font-semibold">— Şefkat Yaşam Evi Bakım Felsefesi</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Promises -->
  <section class="section bg-white">
    <div class="container-x max-w-3xl">
      <SectionHeading
        eyebrow="Size Sözümüz"
        eyebrowIcon="shield-check"
        title="Ailelere verdiğimiz dört söz"
        align="left"
      />
      <ul class="mt-10 space-y-4" data-reveal-group>
        {
          promises.map((p) => (
            <li class="card flex items-center gap-4 p-5" data-reveal-item>
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sage-100 text-sage-600">
                <Icon name="check" size={24} />
              </span>
              <span class="text-lg text-ink font-semibold">{p}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
