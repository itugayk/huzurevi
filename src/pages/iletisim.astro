---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import AppointmentForm from "../components/AppointmentForm.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapsQuery)}`;

const contactCards = [
  { icon: "map-pin", title: "Adres", value: site.address, href: mapsUrl, action: "Yol tarifi al" },
  { icon: "phone", title: "Telefon", value: site.phone, href: `tel:${site.phoneHref}`, action: "Hemen ara" },
  { icon: "mail", title: "E-posta", value: site.email, href: `mailto:${site.email}`, action: "E-posta gönder" },
  { icon: "clock", title: "Ziyaret Saatleri", value: site.visitingHours, href: null, action: null },
];
---

<BaseLayout
  title="İletişim & Ziyaret Randevusu"
  description="Şefkat Yaşam Evi'ni ziyaret edin. Ücretsiz tur ve ön görüşme için randevu oluşturun, bize ulaşın."
>
  <PageHero
    current="İletişim"
    eyebrow="İletişim & Randevu"
    eyebrowIcon="calendar"
    title="Sizi tesisimizde ağırlamak isteriz"
    intro="Aşağıdaki formla birkaç dakikada ziyaret randevusu oluşturabilir veya doğrudan bize ulaşabilirsiniz. Ön görüşme ve tesis turu ücretsizdir."
  />

  <section class="section">
    <div class="container-x grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-14 items-start">
      <!-- Form -->
      <div data-reveal>
        <h2 class="text-2xl md:text-3xl mb-2">Ziyaret Randevusu Oluşturun</h2>
        <p class="text-ink-soft mb-6">İhtiyaçlarınızı dinleyelim, size en uygun zamanı birlikte planlayalım.</p>
        <AppointmentForm />
      </div>

      <!-- Contact info -->
      <div class="space-y-5">
        <!-- Emergency highlight -->
        <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-peach-400 to-peach-500 p-6 text-brand-900" data-reveal>
          <div class="flex items-center gap-4">
            <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-white/40">
              <Icon name="phone" size={30} />
            </span>
            <div>
              <p class="font-bold uppercase tracking-wide text-sm opacity-80">7/24 Acil Bakım Hattı</p>
              <a href={`tel:${site.emergencyHref}`} class="font-display font-extrabold text-2xl">{site.emergency}</a>
            </div>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4" data-reveal-group>
          {
            contactCards.map((c) => (
              <div class="card p-6 h-full flex flex-col" data-reveal-item>
                <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-50 text-brand-600">
                  <Icon name={c.icon} size={26} />
                </span>
                <h3 class="mt-4 text-lg text-brand-800">{c.title}</h3>
                <p class="mt-1 text-ink-soft flex-1">{c.value}</p>
                {c.href && (
                  <a href={c.href} class="link-underline mt-3 text-sm">{c.action}</a>
                )}
              </div>
            ))
          }
        </div>

        <!-- Map mock -->
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener"
          class="group relative block overflow-hidden rounded-[2rem] ring-1 ring-brand-100 shadow-card"
          data-reveal
          aria-label="Haritada konumumuzu açın"
        >
          <div class="aspect-[16/10] bg-brand-100 relative">
            <svg class="absolute inset-0 h-full w-full text-brand-200" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                  <path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width="1.5" />
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="var(--color-brand-50)" />
              <rect width="100%" height="100%" fill="url(#grid)" />
              <path d="M-20 220 L180 120 L360 260 L560 140" fill="none" stroke="var(--color-sage-300)" stroke-width="10" stroke-linecap="round" opacity="0.7"/>
              <path d="M120 -20 L240 200 L200 360" fill="none" stroke="var(--color-peach-300)" stroke-width="10" stroke-linecap="round" opacity="0.7"/>
            </svg>
            <div class="absolute inset-0 grid place-items-center">
              <div class="flex flex-col items-center text-center">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-brand-500 text-white shadow-soft animate-pulse">
                  <Icon name="map-pin" size={30} />
                </span>
                <span class="mt-3 chip">{site.address}</span>
              </div>
            </div>
          </div>
          <div class="bg-white p-4 flex items-center justify-between">
            <span class="font-bold text-brand-800">Konumumuz · Başakşehir / İstanbul</span>
            <span class="link-underline text-sm">Haritada aç</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
